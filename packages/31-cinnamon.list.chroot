# Alpha OS - Package Lists for live-build
# Ubuntu 26.04 LTS (Resolute Raccoon) based distribution
# Cinnamon Desktop Environment Packages

# Cinnamon meta-package
ubuntucinnamon-desktop

# Cinnamon core components
cinnamon
cinnamon-control-center
cinnamon-session
cinnamon-settings-daemon
cinnamon-screensaver
cinnamon-desktop-data
cinnamon-l10n
cinnamon-common

# Cinnamon extensions
cinnamon-spices
cinnamon-spices-networks

# File manager (Cinnamon uses Nemo)
nemo
nemo-fileroller
nemo-python
nemo-media-columns
nemo-filename-repairer

# XApp libraries (used by Cinnamon)
libxapp1
libxapp-common
cinnamon-xapp

# Document viewing
xreader
xreader-djvu
xreader-epub
xreader-pdf
xreader-tiff

# Image viewing
xviewer
xviewer-plugins
eog

# Document editing
libreoffice
libreoffice-l10n-en

# Terminal
gnome-terminal

# Web browser
firefox

# Multimedia
rhythmbox
totem

# System tools
system-tools
gnome-disk-utility

# Display manager (using LightDM across all DEs for consistency)
lightdm
lightdm-gtk-greeter

# Networking
network-manager
network-manager-gnome

# Wayland portal support
xdg-desktop-portal-xapp

# Cinnamon additional components
nemo-fileroller
nemo-preview-thumbnailers

# Input method (IBus)
ibus
ibus-gtk3
ibus-gtk
ibus-qt4
ibus-qt5