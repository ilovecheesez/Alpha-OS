# config/all -- Alpha OS live-build configuration
#
# live-build sources its configuration files in this order:
#     config/all -> config/common -> config/bootstrap -> config/chroot
#                -> config/binary -> config/source
#
# config/all is read FIRST and is NOT generated by `lb config`.  You write it
# by hand.  Anything that must be visible before config/common is sourced goes
# here.  For Alpha OS nothing is required at this stage, so this file is only a
# guard: it must not clobber LB_CONFIG_VERSION, which config/common sets and
# which Check_defaults validates (< 4 for the 3.0~a57 series).

: "${LB_CONFIG_VERSION:=3.0~a57}"
export LB_CONFIG_VERSION
