#!/bin/bash
# Alpha OS - LightDM greeter configuration.
#
# Written to /etc/lightdm/lightdm.conf.d/99-alphaos.conf (the drop-in dir), NOT
# /etc/lightdm/lightdm.conf, because a main conf file would shadow conf.d.
# We do NOT create any .desktop session files: the packaged ones from
# cinnamon-common, plasma-session-*, xfce4-session and gnome-session are already
# correct and duplicating them would shadow them.
# Idempotent (single drop-in is fully rewritten).
set -eu

CONF_DIR=/etc/lightdm/lightdm.conf.d
CONF="$CONF_DIR/99-alphaos.conf"

mkdir -p "$CONF_DIR"

cat > "$CONF" <<'EOF'
# Alpha OS greeter settings. Drop-in directory, applied after lightdm.conf.d/*.
[Seat:*]

# GTK greeter: reliable, small, and shows both X11 and Wayland sessions.
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
greeter-show-manual-login=true
allow-guest=false

# Autologin into the live user so a live session starts with one keypress.
# Ignored by the greeter, used by the live session.
autologin-user=ubuntu
autologin-user-timeout=0
autologin-session=default

# Show BOTH display server sessions in the login list.
# 26.04 session .desktop layout:
#   GNOME 50      : Wayland only (wayland-sessions/gnome.desktop);
#                   X11 only via gnome-session-flashback
#                   (xsessions/gnome-flashback-{compiz,metacity}.desktop)
#   Cinnamon 6.4  : xsessions/cinnamon.desktop, xsessions/cinnamon2d.desktop,
#                   wayland-sessions/cinnamon-wayland.desktop
#   Plasma 6.6    : xsessions/plasmax11.desktop, wayland-sessions/plasma.desktop
#   XFCE 4.20     : xsessions/xfce.desktop, wayland-sessions/xfce-wayland.desktop
#   labwc / wayfire / weston ship standalone wayland sessions.
sessions-directory=/usr/share/xsessions
greeter-sessions-directory=/usr/share/wayland-sessions:/usr/share/xsessions

# Never offer a bare "Custom"/unsafe session entry; do not require a password
# prompt for the live user beyond the autologin timeout above.
display-server allow-privileged=true
EOF

chmod 0644 "$CONF"

# Only GTK greeter may be listed; the others ship with the package. Guard on
# presence so this never fails when lightdm-gtk-greeter is absent.
if [ ! -e /usr/share/xsessions/lightdm-gtk-greeter.desktop ] && \
   [ ! -e /usr/share/lightdm/lightdm-gtk-greeter.desktop ]; then
	echo "40-lightdm: warning: lightdm-gtk-greeter session not found; greeter may fail" >&2
fi

echo "40-lightdm: wrote $CONF"
exit 0
